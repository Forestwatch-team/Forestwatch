# Ignore sensitive credentials
.env

# Ignore Python virtual environment
.venv/

# Ignore compiled Python cache files
__pycache__/
*.pyc

# Ignore OS temporary files
.DS_Store
Thumbs.db
ForestWatch_submission.zip


@"
# Secrets
.env
.streamlit/secrets.toml

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Data and outputs (never commit)
data/raw/
data/processed/
backups/
logs/
scripts/firms/
scripts/gfw/
scripts/firms_*
scripts/gfw_*
ForestWatch_submission.zip
"@ | Set-Content .gitignore -Encoding utf8